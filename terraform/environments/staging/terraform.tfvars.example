# Copier en terraform.tfvars (jamais commite) et renseigner les vraies valeurs
# avant tout `terraform init`/`plan`/`apply` sur cet environnement.

project_id      = "menal-zero-trust-staging"   # projet GCP dedie a la staging, distinct de dev/prod
support_email   = "soc-team@menal-sarl.com"    # alias d equipe, pas une adresse personnelle
admin_ip_ranges = ["203.0.113.10/32"]          # IP(s) admin de la staging, distinctes de celles de dev

# ═══════════════════════════════════════════════════════════════════════════
# MULTI-APP — activation d'Elson (cf. elson.tf), EN DEUX TEMPS :
#
#   Temps 1 (refactos socle) : laisser tout ce bloc commente. L'apply est
#   neutre (moved blocks monitoring seulement).
#
#   Temps 2 (apres le premier push des images elson-* par la CI et l'A record
#   elson.menal-sarl.com -> IP du LB) : decommenter TOUT le bloc d'un coup.
#
# ⚠️ PIEGE : renseigner cloud_run_services ou auth_paths ECRASE les fallbacks
# historiques — TOUJOURS reinclure les valeurs menal-api, sinon on coupe le
# SIEM et l'anti-brute-force de MENAL en meme temps qu'on ajoute Elson.
# ═══════════════════════════════════════════════════════════════════════════

