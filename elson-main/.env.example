# ══════════════════════════════════════════════════════════
# Elson — environnement type (copier en `.env` et compléter)
#   cp .env.example .env
# Tous les secrets sont à générer individuellement (P0-2) :
#   openssl rand -hex 64   → JWT_SECRET / API_KEY_SECRET / AUDIO_URL_SECRET / OTP_PEPPER
# Ne jamais committer de valeur réelle dans `.env`.
# ══════════════════════════════════════════════════════════

# ── PostgreSQL ──
DB_NAME=hassaniya
DB_USER=hassaniya
DB_PASSWORD=change-me-strong-db-password
# Connexion directe au conteneur postgres (PgBouncer retiré — P0-4)
DB_HOST=postgres
DB_PORT=5432
# Pool par worker (4 workers × 30 = 120 < max_connections=150)
DB_MAX_CONNECTIONS=30

# ── Secrets cryptographiques (P0-2 — tous indépendants, requis) ──
JWT_SECRET=change-me-openssl-rand-hex-64
API_KEY_SECRET=change-me-openssl-rand-hex-64
AUDIO_URL_SECRET=change-me-openssl-rand-hex-64
OTP_PEPPER=change-me-openssl-rand-hex-64

# ── Application ──
NODE_ENV=production
PORT=4000
WEB_CONCURRENCY=4
# Origine exacte du frontend (CORS strict, un seul domaine)
FRONTEND_URL=https://app.example.com
# URL publique de l'API vue depuis le navigateur (figée au build du frontend)
NEXT_PUBLIC_API_URL=https://api.example.com

# ── Durées / seuils (optionnels — défauts raisonnables) ──
# JWT_ACCESS_EXPIRES=3h
# JWT_REFRESH_EXPIRES=7d
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60
# PHRASE_LOCK_DURATION_MS=300000
# MIN_SUBMISSION_INTERVAL_MS=10000
# MIN_CONTRIBUTIONS_TARGET=3

# ── Fichiers audio ──
UPLOAD_DIR=/data/recordings
MAX_AUDIO_SIZE_MB=10

# ── SMTP (Zoho) — email désactivé si vide ──
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=

# ── WhatsApp OTP (WAHA) — WhatsApp désactivé si vide ──
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

# ── IA (fonctions IA muettes si absente) ──
# OPENAI_API_KEY=

# ── Démarrage ──
# Seed du jeu de données FLORES au premier boot backend
SEED_FLORES=false
# Migrations automatiques au boot (P1-1) : auto | baseline | off
MIGRATE_MODE=auto
# Admin initial : voir `npm run create-admin` (P0-1) — jamais d'admin en base via SQL
# ADMIN_INITIAL_EMAIL=admin@adst.io
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# ⚠️ ADMIN_BOOTSTRAP=true contourne la whitelist IP admin — à ne positionner QUE
# pendant le tout premier déploiement, puis à retirer immédiatement.
# ADMIN_BOOTSTRAP=false
