# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# data files
*.csv
*.json.bak

# one-off scripts
*.cjs
import_*.js
analyze_*.js

# recordings
/recordings/
/backend/local-recordings/
/backend/sine.wav

# database dumps / backups (never commit — large + sensitive)
*.sql.gz

# scratch media / one-off outputs
/public/elson_PREVIEW_partial.mp4
/community_preview.html
/deploy.log
/inappropriate_check.txt
/sample_check.txt
*.bak-enriched

# leaked credentials export (sensitive — do not track)
/users

# backend dist
/backend/dist/
/backend/node_modules/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
